<?xml version="1.0" encoding="UTF-8"?>
<!-- Núcleo J.A.R.V.I.S. — backend Java (Spring Boot) do Projeto Baluarte.
     Serviço APARTE do site (Vanilla/Vercel): ponte entre o app de celular
     (voz/telemetria/biometria) e o Núcleo, via REST + WebSocket. Fase 2 do
     roadmap #316. Buildar local/CI: `mvn spring-boot:run` (Java 21). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.baluarte</groupId>
  <artifactId>nucleo</artifactId>
  <version>0.1.0</version>
  <name>Baluarte Nucleo</name>
  <description>Núcleo J.A.R.V.I.S. — ponte REST/WebSocket para o app de celular</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
