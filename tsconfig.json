{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "noImplicitAny": true
  },
  "include": [
    "src/core/events.ts",
    "src/core/state.ts",
    "src/core/router.ts",
    "src/core/flags.ts",
    "src/core/permissions.ts"
  ]
}
