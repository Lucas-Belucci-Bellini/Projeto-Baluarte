{
  "name": "baluarte-launcher",
  "productName": "Baluarte Launcher",
  "version": "1.3.4",
  "private": true,
  "description": "Launcher desktop do Projeto Baluarte — hub nativo com conexão à web e auto-update.",
  "author": "Lucas Belucci Bellini",
  "license": "UNLICENSED",
  "main": "src/main.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "build": {
    "appId": "com.baluarte.launcher",
    "productName": "Baluarte Launcher",
    "publish": [
      {
        "provider": "github",
        "owner": "Lucas-Belucci-Bellini",
        "repo": "Projeto-Baluarte",
        "releaseType": "release"
      }
    ],
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/node-llama-cpp/**",
      "**/node_modules/@node-llama-cpp/**"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../v2/core",
        "to": "v2core",
        "filter": [
          "runtime-stdio.js"
        ]
      },
      {
        "from": "../v2/runtime/target/release",
        "to": "runtime",
        "filter": [
          "baluarte-runtime",
          "baluarte-runtime.exe"
        ]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "identity": null,
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSCameraUsageDescription": "O Corpo Total do J.A.R.V.I.S. usa a câmera para rastrear pose e mãos.",
        "NSMicrophoneUsageDescription": "Comandos de voz do J.A.R.V.I.S. usam o microfone."
      }
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.19.0"
  }
}
